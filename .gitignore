__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/
.venv/
venv/

# what a run leaves, and what the memory rebuilds
runs/
worktrees/
memory/cache/

# what measuring coverage leaves behind. Condition 7 asks for a clean tree after
# the suite has run, and `--cov` writes these wherever it is invoked from.
.coverage
coverage.json

# secrets
.env
.env.*

# web-ui build inputs (the built output in src/poieo/web/static IS checked in)
node_modules/
web-ui/dist/

# the harness's own folder: session worktrees, per-machine permissions, and whatever
# a given tool wants there. Nothing a contributor must know lives here -- AGENTS.md
# holds the rules and docs/ holds what they point at, so no tool owns any of it.
.claude/

# personal helper scripts
claude-rc-loop.ps1

# browser automation scratch (console logs, screenshots)
.playwright-mcp/
